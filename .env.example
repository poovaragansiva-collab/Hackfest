# Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Provider Configuration
# ACTIVE_PROVIDER options: automatic1111 (default for local execution), mock (for unit tests only)
ACTIVE_PROVIDER=automatic1111

# Local AUTOMATIC1111 Stable Diffusion WebUI Configuration
# Start WebUI with: webui-user.bat (with COMMANDLINE_ARGS=--api --medvram)
SD_WEBUI_URL=http://127.0.0.1:7860
SD_TIMEOUT_SECONDS=180
SD_DEFAULT_SAMPLER="Euler a"

# Persistent Storage & Artifacts
DATABASE_PATH=backend/data/generations.db
OUTPUT_DIR=backend/outputs
